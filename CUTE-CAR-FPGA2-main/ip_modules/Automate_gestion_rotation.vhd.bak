LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.numeric_std.ALL;

ENTITY Automate_gestion_rotation IS
    PORT (
        posLigne : IN  STD_LOGIC_VECTOR(3 DOWNTO 0);
        Start_SL : IN  STD_LOGIC;
		  Fin_SL   : OUT STD_LOGIC;
        CmdLR_SL : OUT STD_LOGIC_VECTOR(27 DOWNTO 0)
    );
END ENTITY Automate_gestion_rotation;

ARCHITECTURE Automate_gestion_rotation_rtl OF Automate_gestion_rotation IS
	
  -- Définition des fonctions min et max
   function max(a, b: integer) return integer is
   begin
	  if a > b then return a;
	  else return b;
	  end if;
   end function;

   function min(a, b: integer) return integer is
   begin
	  if a < b then return a;
	  else return b;
	  end if;
   end function;
	
	constant PWM_DROIT_AVD  : integer := 2200; --to_integer(X"288C");   -- 10380
	constant PWM_GAUCHE_AVG : integer := 2200; --to_integer(X"288C");   -- 14476
	constant PWM_DROIT_ARD  : integer := 2200; --to_integer(X"388C");   -- 10380
	constant PWM_GAUCHE_ARG : integer := 2200; --to_integer(X"388C");   -- 14476
	constant PID        : integer := 120;
	constant PWM_MAX    : integer := 3125; --to_integer(X"3C34");
	constant PWM_MIN    : integer := 2188;
	
	BEGIN
		automate: process(Start_SL)
		variable posL : integer;
		Variable consigne_MTRR, consigne_MTRL : unsigned(13 downto 0);
		begin 
			if(Start_SL = '1') then
				posL := to_integer(signed(posLigne)); 
				if(posL < -6 OR posL > 6) then
					Fin_SL <= '1';
					CmdLR_SL <= (others => '0');
					
				else
					Fin_SL <= '0';
					if(posL <= -2) then
						consigne_MTRR := "10" & to_unsigned(PWM_DROIT_AVD, 12);
						consigne_MTRL := "11" & to_unsigned(PWM_GAUCHE_ARG, 12);
					elsif(posL >= 2) then
						consigne_MTRR := "11" & to_unsigned(PWM_DROIT_ARD, 12);
						consigne_MTRL := "10" & to_unsigned(PWM_GAUCHE_AVG, 12);
					else
						consigne_MTRR := "10" & to_unsigned(max(min(PWM_DROIT_AVD  - PID*posL, PWM_MAX), PWM_MIN), 12);
						consigne_MTRL := "10" & to_unsigned(max(min(PWM_GAUCHE_AVG + PID*posL, PWM_MAX), PWM_MIN), 12);
					end if;
					CmdLR_SL <= std_LOGIC_VECTOR(consigne_MTRR & consigne_MTRL);
				end if;
			else
				CmdLR_SL <= (others => '0');
			end if;
		end process automate;
end Automate_suiveur_de_ligne_rtl;
				